# Скопируйте в .env и поменяйте значения
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
DJANGO_SECURE_COOKIES=0

POSTGRES_DB=course_platform
POSTGRES_USER=course_platform
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Почта: логины и пароли студентам, восстановление пароля.
# Без EMAIL_HOST письма печатаются в консоль. Для Gmail нужен «пароль приложения»
# (Аккаунт Google → Безопасность → Двухэтапная проверка → Пароли приложений).
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=xxxxxxxxxxxxxxxx
# Mail.ru / Yandex: EMAIL_HOST=smtp.mail.ru или smtp.yandex.ru, EMAIL_PORT=465, EMAIL_USE_TLS=0, EMAIL_USE_SSL=1
